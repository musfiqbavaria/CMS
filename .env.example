# --- Django ---
DJANGO_SECRET_KEY=dev-secret-key-change-me-in-prod-min-50-chars-long-1234567890
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,daphne,nginx
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

# --- Database (PostgreSQL 16) ---
POSTGRES_DB=cms
POSTGRES_USER=cms
POSTGRES_PASSWORD=cms_password_change_me
DB_HOST=db
DB_PORT=5432

# --- Redis 7 / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Superuser (created by entrypoint if set) ---
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=Admin12345!

# --- Auth hardening (defaults shown) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
TOTP_ISSUER=CMS Platform

# --- Uploads / retention (defaults shown) ---
MEDIA_MAX_BYTES=10485760
BACKUP_KEEP_COUNT=7
VERSION_KEEP_COUNT=20

# --- Frontend ---
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
FRONTEND_URL=http://localhost:8080
# Leave blank while local. When deployed, set to the public HTTPS CMS origin.
# This does not publish the CMS or create a tunnel by itself.
CMS_PUBLIC_URL=
VITE_CMS_PUBLIC_URL=

# --- Nginx / hosts ---
NGINX_HTTP_PORT=8080

# --- Hosted sites (Phase 10): free <slug> subdomains + custom domains ---
# Base domain for free subdomains, e.g. sites.example.com. DNS: point a
# wildcard *.base at this server. Django must allow the base and its
# subdomains: DJANGO_ALLOWED_HOSTS=example.com,.example.com
# (leading dot matches subdomains). Frontend needs the same base to offer
# the subdomain option in the Add-website form.
PLATFORM_BASE_DOMAIN=
VITE_PLATFORM_BASE_DOMAIN=
# Hostname customers CNAME custom domains to (Phase 11). Defaults to the base
# domain. Must resolve to this server (e.g. an A record on the base domain).
PLATFORM_INGRESS_HOST=

# --- Sentry (optional, empty disables) ---
SENTRY_DSN=

# --- Email (console backend by default in dev) ---
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@example.com
